{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "SecureHeaders": {
      "CspEnabled": false,
      "CspReportOnlyEnabled": true,
      "PermissionsPolicy": "geolocation=(), microphone=(), camera=()",
      "Csp": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "CspReportOnly": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": []
    }
  },
  "Database": {
    "RunMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 30,
    "LatestRequiredMigration": "000019_h2_security_event_classifier"
  },
  "FileStorage": {
    "Provider": "local",
    "Local": {
      "BasePath": "storage/files"
    },
    "PublicBaseUrl": "",
    "MaxUploadBytes": 10485760,
    "AllowedMimeTypes": [
      "image/png",
      "image/jpeg",
      "image/webp",
      "application/pdf",
      "text/plain"
    ],
    "VirusScanEnabled": false,
    "VirusScan": {
      "Provider": "none",
      "Host": "",
      "Port": 3310,
      "TimeoutSeconds": 10,
      "ChunkSizeBytes": 8192
    }
  },
  "AllowedHosts": "*"
}
