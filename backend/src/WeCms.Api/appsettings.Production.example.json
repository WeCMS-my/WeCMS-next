{
  "AllowedHosts": "admin.example.com",
  "ConnectionStrings": {
    "Default": "__SET_BY_ENV__",
    "Migration": "__SET_BY_SECRET_MANAGER__"
  },
  "Auth": {
    "AccessTokenSecret": "__SET_BY_ENV__",
    "Issuer": "wecms-production",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Database": {
    "SeedAdminPassword": "__SET_BY_SECRET_MANAGER__",
    "RunMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 30,
    "LatestRequiredMigration": "000019_h2_security_event_classifier"
  },
  "Security": {
    "AllowedOrigins": [
      "https://admin.example.com"
    ],
    "RequireOriginForCookieAuth": true,
    "AllowRefererFallbackForCookieAuth": false,
    "SecureHeaders": {
      "CspEnabled": false,
      "CspReportOnlyEnabled": true,
      "PermissionsPolicy": "geolocation=(), microphone=(), camera=()",
      "Csp": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "CspReportOnly": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "ForwardLimit": 1,
      "KnownProxies": [
        "10.0.0.10"
      ],
      "KnownNetworks": [
        "10.0.0.0/24"
      ]
    },
    "LoginFailure": {
      "Enabled": true,
      "WindowMinutes": 10,
      "UsernameThreshold": 5,
      "IpThreshold": 20,
      "BanThreshold": 10,
      "BanMinutes": 15
    },
    "RateLimiting": {
      "AuthLogin": {
        "PermitLimit": 5,
        "WindowMinutes": 1
      },
      "AuthRefresh": {
        "PermitLimit": 20,
        "WindowMinutes": 1
      },
      "AuthTwoFactor": {
        "PermitLimit": 5,
        "WindowMinutes": 1
      },
      "AdminWrite": {
        "PermitLimit": 60,
        "WindowMinutes": 1
      },
      "FileUpload": {
        "PermitLimit": 10,
        "WindowMinutes": 1
      },
      "SecurityUnban": {
        "PermitLimit": 5,
        "WindowMinutes": 1
      }
    },
    "TwoFactor": {
      "SecretProtectionKey": "__SET_BY_ENV__",
      "Issuer": "WeCMS",
      "PeriodSeconds": 30,
      "CodeDigits": 6,
      "AllowedWindowSteps": 1,
      "RecoveryCodeCount": 10,
      "ChallengeMinutes": 5,
      "ChallengeMaxFailedAttempts": 5
    }
  },
  "FileStorage": {
    "Provider": "local",
    "Local": {
      "BasePath": "__SET_BY_ENV__"
    },
    "PublicBaseUrl": "https://files.example.com",
    "MaxUploadBytes": 10485760,
    "AllowedMimeTypes": [
      "image/png",
      "image/jpeg",
      "image/webp",
      "application/pdf",
      "text/plain"
    ],
    "VirusScanEnabled": false,
    "VirusScan": {
      "Provider": "clamav-tcp",
      "Host": "scanner.internal",
      "Port": 3310,
      "TimeoutSeconds": 10,
      "ChunkSizeBytes": 8192
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
