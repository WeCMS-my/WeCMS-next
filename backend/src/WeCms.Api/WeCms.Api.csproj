<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.9" />
    <PackageReference Include="MiniProfiler.AspNetCore.Mvc" Version="4.5.4" />
    <PackageReference Include="Scalar.AspNetCore.Swashbuckle" Version="2.16.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.2" />
    <ProjectReference Include="..\WeCms.Aop\WeCms.Aop.csproj" />
    <ProjectReference Include="..\WeCms.Caching\WeCms.Caching.csproj" />
    <ProjectReference Include="..\WeCms.Data.SqlSugar\WeCms.Data.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.EventBus\WeCms.EventBus.csproj" />
    <ProjectReference Include="..\WeCms.EventBus.SqlSugar\WeCms.EventBus.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.Infrastructure\WeCms.Infrastructure.csproj" />
    <ProjectReference Include="..\WeCms.Modules.AccessControl\WeCms.Modules.AccessControl.csproj" />
    <ProjectReference Include="..\WeCms.Modules.AccessControl.SqlSugar\WeCms.Modules.AccessControl.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Audit\WeCms.Modules.Audit.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Audit.SqlSugar\WeCms.Modules.Audit.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Configuration\WeCms.Modules.Configuration.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Configuration.SqlSugar\WeCms.Modules.Configuration.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.Modules.FileCenter\WeCms.Modules.FileCenter.csproj" />
    <ProjectReference Include="..\WeCms.Modules.FileCenter.SqlSugar\WeCms.Modules.FileCenter.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Identity\WeCms.Modules.Identity.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Identity.SqlSugar\WeCms.Modules.Identity.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Organization\WeCms.Modules.Organization.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Organization.SqlSugar\WeCms.Modules.Organization.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Platform\WeCms.Modules.Platform.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Platform.SqlSugar\WeCms.Modules.Platform.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Security\WeCms.Modules.Security.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Security.SqlSugar\WeCms.Modules.Security.SqlSugar.csproj" />
    <ProjectReference Include="..\WeCms.Shared\WeCms.Shared.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>472e01c3-c8e6-4bfb-a1a4-f563d1f8de46</UserSecretsId>
    <SpaRoot>..\..\..\frontend\soybean-admin</SpaRoot>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>corepack pnpm@10.5.0 dev -- --host 127.0.0.1 --port 5173 --strictPort</SpaProxyLaunchCommand>
  </PropertyGroup>

  <Target Name="BuildFrontendForApi" BeforeTargets="CoreBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipFrontendBuild)' != 'true' and Exists('$(SpaRoot)\package.json')">
    <Message Importance="high" Text="Building frontend project: $(SpaRoot)" />
    <Exec Command="corepack pnpm@10.5.0 --dir &quot;$(SpaRoot)&quot; build" />
  </Target>

</Project>
