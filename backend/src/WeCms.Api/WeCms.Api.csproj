<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- ADR-0006: 当前仅例外化 Dapper 组件的 IL2104/IL3053，严禁自有代码 IL2026/IL3050。 -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WeCms.Tests.Integration" />
    <InternalsVisibleTo Include="WeCms.Tests.Architecture" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeCms.Modules.System\WeCms.Modules.System.csproj" />
    <ProjectReference Include="..\WeCms.Modules.Cms\WeCms.Modules.Cms.csproj" />
    <ProjectReference Include="..\WeCms.Infrastructure\WeCms.Infrastructure.csproj" />
    <ProjectReference Include="..\WeCms.Persistence\WeCms.Persistence.csproj" />
    <ProjectReference Include="..\WeCms.Shared\WeCms.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\database\migrations\*.sql" Link="database\migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\database\seeds\*.sql" Link="database\seeds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
