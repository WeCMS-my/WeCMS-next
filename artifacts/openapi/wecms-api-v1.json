  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ApiResult": {
        "type": "object",
        "required": [
          "code",
          "msg",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "nullable": true
          },
          "traceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "fieldErrors": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Object": {
        "type": "object",
        "additionalProperties": true
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "refreshToken",
          "expiresAt",
          "user",
          "roles",
          "permissions",
          "menus"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "menus": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthMenuDto"
            }
          }
        }
      },
      "AuthMeResponse": {
        "type": "object",
        "required": [
          "user",
          "roles",
          "permissions",
          "menus"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "menus": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthMenuDto"
            }
          }
        }
      },
      "AuthUserDto": {
        "type": "object",
        "required": [
          "id",
          "username",
          "displayName",
          "isSuperAdmin"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "isSuperAdmin": {
            "type": "boolean"
          }
        }
      },
      "AuthMenuDto": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "path",
          "title"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "parentId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "SystemLiveResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "SystemReadyResponse": {
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "database": {
            "type": "boolean"
          }
        }
      },
      "SystemPingResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "SystemVersionResponse": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string"
          }
        }
      },
      "SystemDbCheckResponse": {
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "database": {
            "type": "boolean"
          }
        }
      },
      "SecurePingResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
